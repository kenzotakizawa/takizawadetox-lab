---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Takizawa Detox Lab — ノイズを拭き取り、本質だけを残すツールをつくる個人開発ラボ。" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Shippori+Mincho:wght@400;500;700&display=swap" rel="stylesheet">

    <title>{title} | Takizawa Detox Lab</title>
  </head>
  <body>
    <div class="cursor-dot" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="site-logo" data-cursor>
          <span class="logo-mark" aria-hidden="true"></span>
          Takizawa Detox Lab.
        </a>
        <nav class="site-nav" aria-label="サイト内メニュー">
          <a href="/#works" data-cursor>Works</a>
          <a href="/#extensions" data-cursor>Extensions</a>
          <a href="/#writings" data-cursor>Writings</a>
          <a href="/#contact" data-cursor>Contact</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-left">
          <p class="footer-logo">Takizawa Detox Lab.</p>
          <p class="footer-tagline">ノイズを、拭き取る。</p>
        </div>
        <nav class="footer-nav" aria-label="フッターメニュー">
          <a href="/privacy-policy" data-cursor>Privacy Policy</a>
          <a href="/terms" data-cursor>Terms</a>
        </nav>
        <p class="copyright">&copy; {new Date().getFullYear()} Takizawa Detox Lab.</p>
      </div>
    </footer>

    <script>
      // Cursor follower — soft ring that trails the pointer, grows over links
      const dot = document.querySelector('.cursor-dot') as HTMLElement | null;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (dot && finePointer && !reducedMotion) {
        let x = -100, y = -100, tx = -100, ty = -100;

        window.addEventListener('mousemove', (e) => {
          tx = e.clientX;
          ty = e.clientY;
          dot.classList.add('is-active');
        }, { passive: true });

        document.addEventListener('mouseleave', () => dot.classList.remove('is-active'));

        const loop = () => {
          x += (tx - x) * 0.18;
          y += (ty - y) * 0.18;
          dot.style.transform = `translate(${x}px, ${y}px)`;
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);

        document.querySelectorAll('a, button, [data-cursor]').forEach((el) => {
          el.addEventListener('mouseenter', () => dot.classList.add('is-hover'));
          el.addEventListener('mouseleave', () => dot.classList.remove('is-hover'));
        });
      }

      // Scroll reveal
      const revealTargets = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && revealTargets.length > 0) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        revealTargets.forEach((el) => observer.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .logo-mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
    transition: transform 0.5s var(--ease-out);
  }

  .site-logo:hover .logo-mark {
    transform: scale(1.5);
  }

  .site-nav {
    display: flex;
    gap: 4px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .site-nav a {
    position: relative;
    padding: 8px 14px;
    border-radius: 100px;
    transition: color 0.3s ease, background-color 0.3s ease;
  }

  .site-nav a:hover {
    color: var(--color-accent-ink);
    background-color: var(--color-accent-soft);
  }

  .site-main {
    min-height: calc(100vh - 250px);
  }

  .site-footer {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-lg) 0;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .footer-tagline {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    letter-spacing: 0.15em;
    margin-top: 4px;
  }

  .footer-nav {
    display: flex;
    gap: var(--spacing-md);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .footer-nav a:hover {
    color: var(--color-accent-ink);
  }

  .copyright {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding-top: 14px;
      padding-bottom: 10px;
    }

    .site-logo {
      font-size: 1.05rem;
    }

    .site-nav {
      width: 100%;
      gap: 0;
      flex-wrap: wrap;
    }

    .site-nav a {
      padding: 6px 8px;
      font-size: 0.68rem;
      letter-spacing: 0.08em;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-sm);
    }
  }
</style>
