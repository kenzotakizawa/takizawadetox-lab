  <!-- ================= Contact ================= -->
  <section class="contact" id="contact">
    <div class="container contact-inner reveal">
      <p class="section-label">05 — Contact</p>
      <h2 class="contact-title">静かな道具、つくります。</h2>
      <p class="contact-desc">
        お仕事のご相談、ツールのカスタマイズ、新しいプロダクトのアイデアなど、お気軽にどうぞ。
      </p>
      <a href="mailto:support-extention@takizawadetox-lab.com" class="contact-button" data-magnetic>
        Get in Touch
      </a>
    </div>
  </section>

  <script>
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Hero: wipeable noise canvas ----
    // コンセプト「ノイズを拭き取る」をそのまま体験に。カーソルの軌跡でノイズが消え、時間とともに静かに戻る。
    const canvas = document.getElementById('noise-canvas') as HTMLCanvasElement | null;
    const hero = document.getElementById('hero');

    if (canvas && hero && !reducedMotion) {
      const ctx = canvas.getContext('2d')!;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let width = 0;
      let height = 0;

      // 完成形のノイズを別レイヤーに一度だけ描いておき、
      // メインキャンバスは「拭き取り」と「ゆっくり元に戻る」だけを担当する。
      // 低アルファで重ね続けても元レイヤーの濃度に収束するので、濃くなりすぎない。
      const noiseLayer = document.createElement('canvas');
      const layerCtx = noiseLayer.getContext('2d')!;

      const paintLayer = () => {
        const count = Math.floor((width * height) / (620 * dpr * dpr));
        layerCtx.clearRect(0, 0, width, height);
        for (let i = 0; i < count; i++) {
          const x = Math.random() * width;
          const y = Math.random() * height;
          const r = (Math.random() * 1.3 + 0.4) * dpr;
          const accent = Math.random() < 0.06;
          const alpha = accent ? 0.5 : Math.random() * 0.22 + 0.08;
          layerCtx.fillStyle = accent
            ? `rgba(60, 125, 94, ${alpha})`
            : `rgba(65, 62, 54, ${alpha})`;
          layerCtx.beginPath();
          layerCtx.arc(x, y, r, 0, Math.PI * 2);
          layerCtx.fill();
        }
      };

      const resize = () => {
        width = hero.clientWidth * dpr;
        height = hero.clientHeight * dpr;
        canvas.width = width;
        canvas.height = height;
        noiseLayer.width = width;
        noiseLayer.height = height;
        paintLayer();
        ctx.clearRect(0, 0, width, height);
        ctx.drawImage(noiseLayer, 0, 0);
      };
      resize();
      window.addEventListener('resize', resize, { passive: true });

      const wipe = (clientX: number, clientY: number) => {
        const rect = canvas.getBoundingClientRect();
        const x = (clientX - rect.left) * dpr;
        const y = (clientY - rect.top) * dpr;
        const radius = 64 * dpr;
        const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
        gradient.addColorStop(0, 'rgba(0,0,0,1)');
        gradient.addColorStop(0.6, 'rgba(0,0,0,0.85)');
        gradient.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.globalCompositeOperation = 'destination-out';
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalCompositeOperation = 'source-over';
      };

      hero.addEventListener('pointermove', (e) => wipe(e.clientX, e.clientY), { passive: true });

      // ノイズはゆっくり戻ってくる(拭いても、また積もる)
      let running = true;
      const regen = () => {
        if (running) {
          ctx.globalAlpha = 0.006;
          ctx.drawImage(noiseLayer, 0, 0);
          ctx.globalAlpha = 1;
        }
        requestAnimationFrame(regen);
      };
      requestAnimationFrame(regen);

      new IntersectionObserver(([entry]) => {
        running = entry.isIntersecting;
      }).observe(hero);
    }

    // ---- Tilt: cards lean toward the cursor ----
    if (finePointer && !reducedMotion) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
        el.addEventListener('mousemove', (e) => {
          const rect = el.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width - 0.5;
          const py = (e.clientY - rect.top) / rect.height - 0.5;
          el.style.transform = `perspective(1000px) rotateX(${(-py * 5).toFixed(2)}deg) rotateY(${(px * 7).toFixed(2)}deg) translateY(-6px)`;
        });
        el.addEventListener('mouseleave', () => {
          el.style.transform = '';
        });
      });

      // ---- Magnetic: buttons gently pull toward the cursor ----
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
        el.addEventListener('mousemove', (e) => {
          const rect = el.getBoundingClientRect();
          const dx = e.clientX - (rect.left + rect.width / 2);
          const dy = e.clientY - (rect.top + rect.height / 2);
          el.style.transform = `translate(${dx * 0.22}px, ${dy * 0.3}px)`;
        });
        el.addEventListener('mouseleave', () => {
          el.style.transform = '';
        });
      });
    }
  </script>
</Layout>

<style>
  .sp-only { display: none; }
  .pc-only { display: inline; }

  /* ================================
     Section common
     ================================ */
  .section-header {
    margin-bottom: var(--spacing-lg);
  }

  .section-label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--color-accent);
    margin-bottom: var(--spacing-sm);
  }

  .section-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    letter-spacing: 0.06em;
  }

  .section-sub {
    margin-top: var(--spacing-sm);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  /* ================================
     Hero
     ================================ */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .noise-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
  }

  .hero-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hero-label::before {
    content: '';
    display: inline-block;
    width: 40px;
    height: 1px;
    background-color: var(--color-accent);
  }

  .hero-title {
    font-size: clamp(3rem, 9vw, 6.5rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.25;
    margin-bottom: var(--spacing-md);
  }

  .hero-sub {
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: var(--color-text-muted);
    line-height: 2.3;
    letter-spacing: 0.06em;
    max-width: 640px;
  }

  .hero-hint {
    margin-top: var(--spacing-lg);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-ink);
    background-color: var(--color-accent-soft);
    border-radius: 100px;
    padding: 8px 20px;
  }

  .hint-icon {
    animation: twinkle 2.4s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .hero-scroll {
    position: absolute;
    right: var(--spacing-md);
    bottom: var(--spacing-md);
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--color-text-muted);
    writing-mode: vertical-rl;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background-color: var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -50%;
    left: 0;
    width: 100%;
    height: 50%;
    background-color: var(--color-accent);
    animation: scrollLine 2s var(--ease-out) infinite;
  }

  @keyframes scrollLine {
    0% { top: -50%; }
    100% { top: 110%; }
  }

  /* ================================
     Philosophy
     ================================ */
  .philosophy {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .philosophy-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: var(--spacing-md);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out), border-color 0.4s ease;
  }

  .philosophy-item:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
  }

  .philosophy-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-accent-soft);
    color: var(--color-accent-ink);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin-bottom: var(--spacing-sm);
  }

  .philosophy-title {
    font-size: 1.25rem;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .philosophy-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 2;
  }

  /* ================================
     Works — featured web apps
     ================================ */
  .works {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .work {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
    padding: var(--spacing-lg) 0;
  }

  .work + .work {
    border-top: 1px dashed var(--color-border);
  }

  .work-reverse .work-visual {
    order: 2;
  }

  .work-reverse .work-body {
    order: 1;
  }

  .work-visual {
    display: block;
    transition: transform 0.5s var(--ease-out);
    will-change: transform;
  }

  /* --- Browser mockup --- */
  .mock-window {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    font-family: var(--font-sans);
  }

  .mock-titlebar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    background-color: #fbfaf7;
  }

  .mock-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-border);
  }

  .mock-url {
    margin-left: 12px;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    border-radius: 100px;
    padding: 3px 14px;
  }

  .mock-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .mock-tool {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .mock-tool.is-active {
    background-color: var(--color-accent-soft);
    border-color: var(--color-accent);
  }

  .mock-tool-gap {
    flex: 1;
  }

  .mock-tool-accent {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .mock-canvas {
    position: relative;
    padding: 28px;
    min-height: 260px;
    background:
      linear-gradient(45deg, #f4f2ec 25%, transparent 25%, transparent 75%, #f4f2ec 75%),
      linear-gradient(45deg, #f4f2ec 25%, transparent 25%, transparent 75%, #f4f2ec 75%);
    background-color: #faf9f5;
    background-size: 22px 22px;
    background-position: 0 0, 11px 11px;
  }

  .mock-shot {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
    padding: 22px;
    width: 78%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mock-shot-line {
    display: block;
    height: 9px;
    border-radius: 100px;
    background-color: #e9e6de;
  }

  .mock-blurred {
    background: repeating-linear-gradient(90deg, #d7d3c8 0 6px, #eceae3 6px 12px);
    filter: blur(2.5px);
  }

  .mock-step {
    position: absolute;
    top: 20px;
    right: 24%;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(60, 125, 94, 0.35);
  }

  .mock-step-2 {
    top: auto;
    bottom: 34px;
    right: 12%;
  }

  .mock-arrow {
    position: absolute;
    right: 8%;
    top: 34%;
    width: 120px;
    color: var(--color-accent);
  }

  .mock-spotlight {
    position: absolute;
    left: 18%;
    bottom: 26px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 244, 176, 0.55) 0%, rgba(255, 244, 176, 0) 70%);
    border: 1.5px dashed rgba(200, 170, 60, 0.55);
  }

  /* --- 様子見KB mockup --- */
  .mock-search {
    display: flex;
    gap: 10px;
    padding: 22px 22px 14px;
  }

  .mock-search-input {
    flex: 1;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--color-text);
    background-color: var(--color-bg);
    position: relative;
  }

  .mock-search-input::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1em;
    background-color: var(--color-accent);
    margin-left: 3px;
    vertical-align: text-bottom;
    animation: caret 1.1s steps(1) infinite;
  }

  @keyframes caret {
    50% { opacity: 0; }
  }

  .mock-search-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 22px;
    border-radius: 10px;
    background-color: var(--color-accent);
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  .mock-results {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 8px 22px 24px;
  }

  .mock-result {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 14px 16px;
    background-color: var(--color-surface);
  }

  .mock-kb {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .mock-result-line {
    flex: 1;
    max-width: 52%;
    height: 8px;
    border-radius: 100px;
    background-color: #ece9e1;
  }

  .verdict {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    border-radius: 100px;
    padding: 4px 14px;
    white-space: nowrap;
  }

  .verdict-ok {
    background-color: #e5f2e6;
    color: #2c6b3f;
  }

  .verdict-wait {
    background-color: #faf0d7;
    color: #8f6b14;
  }

  .verdict-ng {
    background-color: #fbe7e4;
    color: #a13c30;
  }

  /* --- Work text --- */
  .work-heading {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  .work-title {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    letter-spacing: 0.04em;
  }

  .work-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-ink);
    background-color: var(--color-accent-soft);
    border-radius: 100px;
    padding: 5px 14px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .work-copy {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    line-height: 2;
    margin-bottom: var(--spacing-sm);
  }

  .work-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 2;
    margin-bottom: var(--spacing-sm);
  }

  .work-points {
    list-style: none;
    margin: 0 0 var(--spacing-sm);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .work-points li {
    position: relative;
    padding-left: 22px;
    font-size: 0.88rem;
    color: var(--color-text);
    letter-spacing: 0.03em;
  }

  .work-points li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 600;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--spacing-md);
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 5px 14px;
    background-color: var(--color-surface);
  }

  .work-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-accent-ink);
    border: 1.5px solid var(--color-accent);
    border-radius: 100px;
    padding: 13px 32px;
    transition: background-color 0.35s ease, color 0.35s ease, transform 0.2s ease-out;
    will-change: transform;
  }

  .work-link:hover {
    background-color: var(--color-accent);
    color: #fff;
  }

  .link-arrow {
    transition: transform 0.35s var(--ease-out);
  }

  .work-link:hover .link-arrow {
    transform: translateX(5px);
  }

  /* ================================
     Extensions
     ================================ */
  .extensions {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .ext-list {
    display: flex;
    flex-direction: column;
  }

  .ext-item {
    display: grid;
    grid-template-columns: 52px 48px 1fr auto;
    gap: var(--spacing-md);
    align-items: center;
    padding: var(--spacing-md) var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
    border-radius: 12px;
    position: relative;
    transition: background-color 0.4s ease, padding-left 0.5s var(--ease-out);
  }

  .ext-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .ext-item:hover {
    background-color: var(--color-surface);
    padding-left: var(--spacing-md);
  }

  .ext-num {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
  }

  .ext-item:hover .ext-num {
    color: var(--color-accent);
  }

  .ext-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    transition: transform 0.5s var(--ease-out);
  }

  .ext-item:hover .ext-icon {
    transform: scale(1.1) rotate(-3deg);
  }

  .ext-top {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .ext-title {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    letter-spacing: 0.03em;
  }

  .ext-tag {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .ext-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.9;
    margin-top: 4px;
  }

  .ext-arrow {
    font-size: 1.3rem;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.4s ease, transform 0.4s var(--ease-out);
  }

  .ext-item:hover .ext-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ================================
     Writings
     ================================ */
  .writings {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .writings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .writing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: var(--spacing-md);
    min-height: 200px;
    overflow: hidden;
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out), border-color 0.4s ease;
  }

  .writing-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 20%, transparent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .writing-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in srgb, var(--color-accent) 25%, var(--color-border));
  }

  .writing-card:hover::after {
    transform: scaleX(1);
  }

  .writing-card:first-child {
    grid-column: 1 / -1;
  }

  .writing-card:first-child .writing-title {
    font-size: 1.45rem;
  }

  .writing-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .platform-badge {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 12px;
    border-radius: 100px;
    line-height: 1.4;
  }

  .platform-note {
    background-color: #e5f2e6;
    color: #2c8a37;
  }

  .platform-zenn {
    background-color: #e3edfc;
    color: #2470d6;
  }

  .platform-qiita {
    background-color: #e9f5dd;
    color: #4d9414;
  }

  .writing-category {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }

  .writing-title {
    font-size: 1.15rem;
    line-height: 1.7;
    letter-spacing: 0.03em;
    flex-grow: 1;
  }

  .writing-excerpt {
    font-size: 0.86rem;
    color: var(--color-text-muted);
    line-height: 1.9;
  }

  .writing-arrow {
    align-self: flex-end;
    font-size: 1.2rem;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.4s ease, transform 0.4s var(--ease-out);
  }

  .writing-card:hover .writing-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ================================
     Contact
     ================================ */
  .contact {
    padding: var(--spacing-xl) 0 var(--spacing-lg);
  }

  .contact-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .contact-title {
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    letter-spacing: 0.08em;
    text-wrap: balance;
  }

  .contact-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 2.2;
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--spacing-sm);
    padding: 18px 56px;
    background-color: var(--color-accent);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    border-radius: 100px;
    box-shadow: 0 8px 24px rgba(60, 125, 94, 0.28);
    transition: box-shadow 0.4s ease, background-color 0.4s ease, transform 0.2s ease-out;
    will-change: transform;
  }

  .contact-button:hover {
    background-color: var(--color-accent-ink);
    box-shadow: 0 12px 32px rgba(60, 125, 94, 0.38);
  }

  /* ================================
     Responsive — 900px
     ================================ */
  @media (max-width: 900px) {
    .philosophy-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
    }

    .work,
    .work-reverse {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .work-reverse .work-visual {
      order: 0;
    }

    .work-reverse .work-body {
      order: 1;
    }

    .writings-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
    }

    .writing-card:first-child .writing-title {
      font-size: 1.2rem;
    }

    .ext-item {
      grid-template-columns: 40px 44px 1fr;
      gap: var(--spacing-sm);
    }

    .ext-arrow {
      display: none;
    }
  }

  /* ================================
     Responsive — 480px
     ================================ */
  @media (max-width: 480px) {
    .sp-only { display: inline; }
    .pc-only { display: none; }

    .hero {
      min-height: 78vh;
    }

    .hero-title {
      font-size: clamp(2.4rem, 12vw, 3rem);
    }

    .hero-sub {
      font-size: 0.88rem;
      line-height: 2.1;
    }

    .hero-hint {
      font-size: 0.72rem;
      padding: 7px 16px;
    }

    .hero-scroll {
      display: none;
